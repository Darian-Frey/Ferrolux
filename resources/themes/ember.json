    "thumb-height":     7,
    "fader-travel":    64,
    "detent":           7
  },

  "type": {
    "readout-numeric": "DSEG7 Classic",
    "readout-text":    "Handjet Circle Single",
    "readout-segment": "DSEG14 Classic",
    "legend":          "IBM Plex Sans Condensed",

    "size-readout-large": 20,
