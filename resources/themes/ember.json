{
  "name": "ember",
  "description": "Burnt orange chassis, amber readouts. The loudest of the four.",

  "palette": {
    "shell":           "#B4794A",
    "shell-recess":    "#CE9264",
    "shell-edge":      "#8A5730",
    "display-bg":      "#2B211A",
    "readout":         "#EF9F27",
    "readout-dim":     "#BA7517",
    "readout-floor":   "#854F0B",
    "ink":             "#261508"
  },

  "metrics": {
    "reference-width": 720,
    "scale-min": 0.75,
    "scale-max": 3.0,

    "radius-panel":   12,
